}

    // ---------- Expand to seats (add pinned Fixed) ----------
    static String seatKey(String module, String opId, int dayId, int idx) {
        return module + "|" + opId + "|" + dayId + "|" + idx;
    }
    static class ExpandResult {
        List<CrewSeat> seats; // includes pinned for Fixed
        Map<Integer, Integer> dayIdToLocal; // identity, kept for clarity
    }

    static ExpandResult expandToSeats(List<DaySlot> daySlots,
                                      List<TaskWindow> windows,
                                      List<BlockDecision> blocks,
                                      List<FixedAssign> fixedRows,
                                      Map<String, EmployeeFact> byWid) {

        Map<String, String> moduleOpToFactory = new HashMap<>();
        for (TaskWindow w : windows) {
            moduleOpToFactory.put(w.module + "|" + w.opId, w.factory);
        }

        List<CrewSeat> out = new ArrayList<>();
        int sid = 1;

        // 1) Pinned (Fixed) seats – respect exact hours & wid per day
        for (FixedAssign fa : fixedRows) {
            if (fa.hoursByDay.isEmpty()) continue;
            String factory = moduleOpToFactory.getOrDefault(fa.module + "|" + fa.opId, null);
            for (Map.Entry<Integer,Integer> e : fa.hoursByDay.entrySet()) {
                int dayId = e.getKey();
                int hrs = e.getValue();
                if (hrs <= 0) continue;
                CrewSeat cs = new CrewSeat();
                cs.id = sid++;
                cs.module = fa.module;
                cs.opId = fa.opId;
                cs.phaseId = fa.phaseId;
                cs.phaseNum = fa.phaseNum;
                cs.factory = factory;
                cs.startDayId = dayId;
                cs.days = 1;
                cs.hours = hrs;
                cs.seatIndex = 0;
                cs.seatKey = seatKey(cs.module, cs.opId, dayId, 0);
                cs.blockId = -1;
                cs.pinned = true;
                cs.pinnedWid = fa.wid;
                cs.employee = byWid.getOrDefault(fa.wid, null); // will be enforced by constraints
                out.add(cs);
            }
        }

        // 2) Seats from Pass 1 blocks (flexible)
        for (BlockDecision b : blocks) {
            if (b.startDay == null || b.days == null || b.heads == null) continue;
            int hPer = autoHours(b);
            int created = 0;
            for (int d = 0; d < b.days; d++) {
                int dayId = b.startDay + d;
                if (!isWorkingDay(dayId, b.factory)) continue; // skip non-working
                for (int i = 0; i < Math.max(1, b.heads); i++) {
                    CrewSeat cs = new CrewSeat();
                    cs.id = sid++;
                    cs.module = b.module;
                    cs.opId = b.opId;
                    cs.phaseId = b.phaseId;
                    cs.phaseNum = b.phaseNum;
                    cs.factory = b.factory;
                    cs.startDayId = dayId;
                    cs.days = 1;
                    cs.hours = hPer;
                    cs.seatIndex = i;
                    cs.seatKey = seatKey(cs.module, cs.opId, dayId, i);
                    cs.blockId = b.id;
                    cs.pinned = false;
                    cs.pinnedWid = null;
                    cs.employee = null; // to be assigned
                    out.add(cs);
                    created++;
                }
            }
        }

        ExpandResult r = new ExpandResult();
        r.seats = out;
        r.dayIdToLocal = new HashMap<>();
        for (DaySlot ds : daySlots) r.dayIdToLocal.put(ds.id, ds.id);
        return r;
    }

    // ---------- Pass 2 (employee assignment) ----------
    @PlanningSolution
    public static class Pass2Plan {
        @ProblemFactCollectionProperty public List<DaySlot> daySlots;
        @ProblemFactCollectionProperty public List<EmployeeFact> employees;
        @PlanningEntityCollectionProperty public List<CrewSeat> seats;
        @PlanningScore private HardMediumSoftScore score;
        public Pass2Plan() {}
        public HardMediumSoftScore getScore() { return score; }
        public void setScore(HardMediumSoftScore s) { this.score = s; }
    }

    public static class Pass2Constraints implements ConstraintProvider {
        // HARD
        @Override public Constraint[] defineConstraints(ConstraintFactory f) {
            return new Constraint[] {
                pinnedMustMatch(f),            // pinned seats must keep their worker
                seatMustBeFilled(f),           // no null / UNASSIGNED
                skillRequired(f),              // must have op skill > 0
                noDoubleBookPerDay(f),         // one worker per day (across any ops)
                obeyWorkerOffdays(f),          // worker unavailable calendar
                obeyCompanyAndFabOffdays(f),   // company/fab/region/customer/weekends
                dailyHoursCap(f),              // sum hours per worker per day <= DAILY_CAP

                // SOFT (fairness & skill fit)
                preferHigherSkill(f),
                balanceTotalHours(f)
            };
        }

        Constraint pinnedMustMatch(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> cs.pinned)
                .filter(cs -> cs.employee == null || cs.pinnedWid == null || cs.employee.wid == null
                              || !cs.pinnedWid.equals(cs.employee.wid))
                .penalize(HardMediumSoftScore.ONE_HARD)
                .asConstraint("p2-pinned-must-match");
        }

        Constraint seatMustBeFilled(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> cs.employee == null || isUnassigned(cs.employee))
                .penalize(HardMediumSoftScore.ONE_HARD)
                .asConstraint("p2-seat-must-be-filled");
        }

        Constraint skillRequired(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> cs.employee == null || skill(cs.employee, cs.opId) <= 0)
                .penalize(HardMediumSoftScore.ONE_HARD)
                .asConstraint("p2-skill-required");
        }

        Constraint noDoubleBookPerDay(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> cs.employee != null && !isUnassigned(cs.employee))
                .groupBy(
                    cs -> cs.employee.id,
                    cs -> cs.startDayId,
                    ConstraintCollectors.count())
                .filter((empId, dayId, cnt) -> cnt > 1)
                .penalize(HardMediumSoftScore.ONE_HARD, (empId, dayId, cnt) -> cnt - 1)
                .asConstraint("p2-no-double-book-per-day");
        }

        Constraint obeyWorkerOffdays(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> {
                    if (cs.employee == null || cs.employee.wid == null) return true;
                    Set<Integer> off = CAL.workerOffByWid.getOrDefault(cs.employee.wid, Set.of());
                    return off.contains(cs.startDayId);
                })
                .penalize(HardMediumSoftScore.ONE_HARD)
                .asConstraint("p2-worker-offdays");
        }

        Constraint obeyCompanyAndFabOffdays(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> {
                    if (cs.employee == null) return false; // already penalized elsewhere
                    // weekend or fab/reg/customer closure
                    if (!isWorkingDay(cs.startDayId, cs.factory)) return true;
                    // worker company closure
                    String comp = company(cs.employee);
                    if (comp != null && !comp.isEmpty()) {
                        if (CAL.workerCompanyOff.getOrDefault(comp, Set.of()).contains(cs.startDayId)) return true;
                    }
                    return false;
                })
                .penalize(HardMediumSoftScore.ONE_HARD)
                .asConstraint("p2-company-fab-offdays");
        }

        Constraint dailyHoursCap(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> cs.employee != null && !isUnassigned(cs.employee))
                .groupBy(
                    cs -> cs.employee.id,
                    cs -> cs.startDayId,
                    ConstraintCollectors.sumInt(cs -> Math.max(0, cs.hours)))
                .filter((empId, dayId, sumH) -> sumH > DAILY_CAP)
                .penalize(HardMediumSoftScore.ONE_HARD, (empId, dayId, sumH) -> sumH - DAILY_CAP)
                .asConstraint("p2-daily-hours-cap");
        }

        // -------- SOFT --------
        Constraint preferHigherSkill(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> cs.employee != null && !isUnassigned(cs.employee))
                .reward(HardMediumSoftScore.ONE_SOFT, cs -> Math.max(0, skill(cs.employee, cs.opId)))
                .asConstraint("p2-soft-prefer-higher-skill");
        }

        // Try to balance total hours across employees around TARGET_HOURS_PER_EMP
        Constraint balanceTotalHours(ConstraintFactory f) {
            return f.forEach(CrewSeat.class)
                .filter(cs -> cs.employee != null && !isUnassigned(cs.employee))
                .groupBy(
                    cs -> cs.employee.id,
                    ConstraintCollectors.sumInt(cs -> Math.max(0, cs.hours)))
                .penalize(HardMediumSoftScore.ONE_SOFT, (empId, totalHrs) -> {
                    // quadratic-ish spread; lighter penalty near target
                    double diff = Math.abs(totalHrs - TARGET_HOURS_PER_EMP);
                    return (int)Math.round(diff);
                })
                .asConstraint("p2-soft-balance-total-hours");
        }
    }

    // ---------- Export solved result ----------
    static class ExportRow {
        String operationTask; String worker; int dayId; int hours; String factory;
        String module; String opId;
    }

    static void exportSolved(String schedPath,
                             LocalDate horizonStart,
                             List<DaySlot> daySlots,
                             List<CrewSeat> seats) throws IOException {

        // Aggregate by (module|op|wid|dayId) hours
        Map<String, Integer> map = new LinkedHashMap<>();
        Map<String, String> factoryByKey = new HashMap<>();
        for (CrewSeat cs : seats) {
            if (cs.employee == null || isUnassigned(cs.employee)) continue;
            String key = cs.module + "|" + cs.opId + "|" + cs.employee.wid + "|" + cs.startDayId;
            map.merge(key, Math.max(0, cs.hours), Integer::sum);
            if (cs.factory != null) factoryByKey.putIfAbsent(key, cs.factory);
        }

        // Build YAML tree
        Map<String, Object> root = new LinkedHashMap<>();
        Map<String, Object> schedule = new LinkedHashMap<>();
        root.put("schedule", schedule);

        List<Map<String,Object>> assignmentList = new ArrayList<>();
        for (Map.Entry<String,Integer> e : map.entrySet()) {
            String[] parts = e.getKey().split("\\|", 4);
            String module = parts[0];
            String opId = parts[1];
            String wid = parts[2];
            int dayId = Integer.parseInt(parts[3]);
            int hrs = e.getValue();

            LocalDate date = horizonStart.plusDays(dayId);
            Map<String, Object> row = new LinkedHashMap<>();
            row.put("operation_task", module + opId);
            row.put("worker", wid);
            row.put("plan_flexibility", "flexible"); // result of planning
            row.put("work_date_list", List.of(Map.of(
                    "date", date.format(DF),
                    "hour", hrs
            )));
            String f = factoryByKey.get(e.getKey());
            if (f != null) row.put("fab", f);
            assignmentList.add(row);
        }
        schedule.put("assignment_list_solved", assignmentList);

        // Write to alongside original as *_solved.yaml
        Path p = Paths.get(schedPath);
        String solvedName = p.getFileName().toString().replace(".yaml", "_solved.yaml");
        Path out = p.getParent() == null ? Paths.get(solvedName) : p.getParent().resolve(solvedName);

        saveYaml(out.toString(), root);
        System.out.println("Wrote: " + out.toAbsolutePath());
    }

    // ---------- Orchestration ----------
    public static class SolveResult {
        Pass1Result pass1;
        List<CrewSeat> seatsSolved;
        HardMediumSoftScore p2Score;
    }

    public static SolveResult solveFromYaml(String envPath, String schedPath) throws IOException {
        long t0 = System.nanoTime();

        // Parse & build calendars using expanded horizon
        ParsedEnv env = parseEnv(envPath);
        ParsedSchedule sch = parseSchedule(schedPath, env.opdef);
        buildCalendars(envPath, sch.planStart, sch.planEnd);

        // Fixed baseline for incremental capacity
        List<FixedHeadDay> fixedBase = buildFixedHeadDays(sch.fixedRows);

        // PASS 1: hours ramp to choose windows/heads/days
        Pass1Result p1 = solvePass1HoursRamp(sch.daySlots, sch.windows, sch.fixedHoursByKey, fixedBase);

        // Expand to seats (+ pinned from Fixed rows)
        ExpandResult exp = expandToSeats(sch.daySlots, sch.windows, p1.blocks, sch.fixedRows, env.byWid);

        // Fairness target = total planned hours / number of real employees
        int totalHours = exp.seats.stream().mapToInt(cs -> Math.max(0, cs.hours)).sum();
        long realEmp = env.employees.stream().filter(e -> e.id != 0).count();
        TARGET_HOURS_PER_EMP = realEmp == 0 ? 0.0 : (totalHours / (double) realEmp);

        // PASS 2: assign workers to seats
        Pass2Plan p2 = new Pass2Plan();
        p2.daySlots = sch.daySlots;
        p2.employees = env.employees;
        p2.seats = exp.seats;

        Solver<Pass2Plan> solver = buildSolver(Pass2Plan.class, new Class<?>[]{ CrewSeat.class },
                Pass2Constraints.class, "0hard/*medium/*soft", 25, 45);
        Pass2Plan solved = solver.solve(p2);

        // Export
        exportSolved(schedPath, sch.planStart, sch.daySlots, solved.seats);

        long t1 = System.nanoTime();
        System.out.println("Done. Elapsed " + fmt(java.time.Duration.ofNanos(t1 - t0)));

        SolveResult r = new SolveResult();
        r.pass1 = p1;
        r.seatsSolved = solved.seats;
        r.p2Score = solved.getScore();
        return r;
    }

    // ---------- Main ----------
    public static void main(String[] args) throws Exception {
        if (args.length < 2) {
            System.err.println("Usage: mvn -q exec:java -D\"exec.args=<EnvConfig.yaml> <Schedule.yaml>\"");
            System.exit(2);
        }
        String envPath = args[0];
        String schedPath = args[1];
        SolveResult r = solveFromYaml(envPath, schedPath);

        System.out.println("Pass1 score: " + String.valueOf(r.pass1.score) +
                " (tier=" + r.pass1.tierUsed + ", hardZero=" + r.pass1.hardIsZero + ")");
        System.out.println("Pass2 score: " + String.valueOf(r.p2Score));
    }
