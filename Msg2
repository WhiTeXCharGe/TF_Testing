"""
seiban_extractor.py
--------------------------------------------------------------
Scans every cell of every sheet in an .xlsx / .xlsm file and pulls out
seiban / tool-code strings like 530N03157A / 830300208A
(pattern: 3 digits + 1 alnum + 5 digits + "A", same as Decoder5.TOOLCODE_RE).

Handles messy cells:
  - full-width / zero-width chars (NFKC normalize)
  - stray spaces INSIDE the code (e.g. "530N 03157A") -> retried after
    stripping all whitespace, and flagged as "space_fixed" so you can
    sanity-check it wasn't a false match.

Usage:
    python seiban_extractor.py "path/to/file.xlsx"
    python seiban_extractor.py "path/to/file.xlsx" --sheet "IFS"
    python seiban_extractor.py "path/to/file.xlsx" --out report.csv

Output:
    - Prints unique seiban list + counts to console
    - Writes a CSV report (default: seiban_report.csv) with every
      occurrence: sheet, cell, code, space_fixed?, raw text
--------------------------------------------------------------
"""
import argparse
import csv
import re
import unicodedata
from collections import defaultdict
from datetime import datetime
from openpyxl import load_workbook

# Same core pattern Decoder5.py uses (TOOLCODE_RE)
SEIBAN_RE = re.compile(r"\d{3}[A-Z0-9]\d{5}A")

# Looser pattern for spotting "near miss" candidates that don't fit the
# strict rule above (e.g. wrong trailing letter, extra char) so you can
# eyeball anything unusual instead of it silently vanishing.
NEAR_MISS_RE = re.compile(r"\d{3}[A-Z0-9]\d{5}[A-Z]")

_WS_RE = re.compile(r"\s+")
_ZERO_WIDTH = {"\u200b", "\u200c", "\u200d", "\ufeff"}


def clean_text(s: str) -> str:
    if not isinstance(s, str):
        return ""
    s = unicodedata.normalize("NFKC", s)
    s = s.replace("　", " ")  # full-width space -> normal space
    for z in _ZERO_WIDTH:
        s = s.replace(z, "")
    return s


def find_codes(raw_value):
    """
    Returns a list of (code, space_fixed: bool, near_miss: bool) found in one cell.
    """
    if raw_value is None:
        return []
    text = clean_text(str(raw_value))
    if not text.strip():
        return []

    results = []

    # 1) Strict match on cleaned (but space-preserved) text
    strict_matches = set(m.group(0) for m in SEIBAN_RE.finditer(text))
    for code in strict_matches:
        results.append((code.upper(), False, False))

    # 2) If nothing found, retry with ALL whitespace stripped
    #    (catches "530N 03157A", "530N03157 A", etc.)
    if not strict_matches:
        stripped = _WS_RE.sub("", text)
        stripped_matches = set(m.group(0) for m in SEIBAN_RE.finditer(stripped))
        for code in stripped_matches:
            results.append((code.upper(), True, False))

    # 3) Near-miss detection (only report if nothing strict was found at all,
    #    so we don't spam near-misses for cells that already matched cleanly)
    if not results:
        stripped = _WS_RE.sub("", text)
        near = set(m.group(0) for m in NEAR_MISS_RE.finditer(stripped))
        for code in near:
            results.append((code.upper(), True, True))

    return results


def parse_range_date(s: str):
    """Parse a 'YYYY/MM/DD' or 'YYYY-MM-DD' string into a datetime."""
    s = s.strip()
    for fmt in ("%Y/%m/%d", "%Y-%m-%d"):
        try:
            return datetime.strptime(s, fmt)
        except ValueError:
            continue
    raise ValueError(f"Could not parse date: {s!r} (use YYYY/MM/DD)")


def find_date_header_row(ws, max_scan_rows=12):
    """
    Scan the first N rows of a sheet for one containing actual date values.
    Returns (row_idx, {col_idx: datetime}) or (None, {}) if no date row found.
    This is how worker x date grids (e.g. SU_Others) mark their date columns.
    """
    for r in range(1, max_scan_rows + 1):
        row_cells = list(ws[r])
        date_cols = {}
        for cell in row_cells:
            if isinstance(cell.value, datetime):
                date_cols[cell.column] = cell.value
        if date_cols:
            return r, date_cols
    return None, {}


def scan_workbook(path, sheet_name=None, date_start=None, date_end=None):
    wb = load_workbook(path, data_only=True, read_only=False)
    sheets = [sheet_name] if sheet_name else wb.sheetnames

    occurrences = []  # list of dicts: sheet, cell, code, space_fixed, near_miss, raw
    use_range = date_start is not None and date_end is not None

    for sn in sheets:
        if sn not in wb.sheetnames:
            print(f"  [skip] sheet '{sn}' not found in workbook")
            continue
        ws = wb[sn]

        allowed_cols = None  # None = no column restriction
        if use_range:
            header_row, date_cols = find_date_header_row(ws)
            if header_row is None:
                print(f"  [skip] sheet '{sn}': no date header row found, can't scope by date")
                continue
            allowed_cols = {c for c, dt in date_cols.items() if date_start <= dt <= date_end}
            if not allowed_cols:
                print(f"  [skip] sheet '{sn}': no date columns fall inside the given range")
                continue

        for row in ws.iter_rows():
            for cell in row:
                if allowed_cols is not None and cell.column not in allowed_cols:
                    continue
                if cell.value is None:
                    continue
                for code, space_fixed, near_miss in find_codes(cell.value):
                    occurrences.append({
                        "sheet": sn,
                        "cell": cell.coordinate,
                        "code": code,
                        "space_fixed": space_fixed,
                        "near_miss": near_miss,
                        "raw_text": str(cell.value),
                    })
    return occurrences


def summarize(occurrences):
    counts = defaultdict(int)
    space_fixed_codes = set()
    near_miss_codes = set()

    for o in occurrences:
        if o["near_miss"]:
            near_miss_codes.add(o["code"])
            continue
        counts[o["code"]] += 1
        if o["space_fixed"]:
            space_fixed_codes.add(o["code"])

    return counts, space_fixed_codes, near_miss_codes


def main():
    ap = argparse.ArgumentParser(description="Extract seiban/tool codes from an xlsx/xlsm file.")
    ap.add_argument("xlsx_path", help="Path to the .xlsx or .xlsm file")
    ap.add_argument("--sheet", default=None, help="Only scan this sheet (default: all sheets)")
    ap.add_argument("--out", default="seiban_report.txt", help="TXT report output path")
    ap.add_argument("--range", default=None,
                     help="Only include seiban whose DATE COLUMN falls in this range, "
                          "e.g. --range 2026/06/01-2026/07/01. Requires the sheet to have "
                          "a date header row (worker x date grid, like SU_Others).")
    args = ap.parse_args()

    date_start = date_end = None
    if args.range:
        parts = [p.strip() for p in args.range.replace("〜", "-").split("-") if p.strip()]
        if len(parts) != 2:
            raise SystemExit(f"--range must be like 2026/06/01-2026/07/01, got: {args.range!r}")
        date_start, date_end = parse_range_date(parts[0]), parse_range_date(parts[1])
        if date_end < date_start:
            date_start, date_end = date_end, date_start

    print(f"Scanning: {args.xlsx_path}" + (f" (sheet: {args.sheet})" if args.sheet else " (all sheets)"))
    if date_start:
        print(f"Date range: {date_start:%Y/%m/%d} - {date_end:%Y/%m/%d}")
    occurrences = scan_workbook(args.xlsx_path, args.sheet, date_start, date_end)
    counts, space_fixed_codes, near_miss_codes = summarize(occurrences)

    print(f"\nFound {len(counts)} unique seiban codes.\n")
    for code in sorted(counts):
        flag = "  <- had stray spaces, fixed" if code in space_fixed_codes else ""
        print(f"  {code}{flag}")

    if near_miss_codes:
        print(f"\n{len(near_miss_codes)} NEAR-MISS codes (matched loosely, review these manually):")
        for code in sorted(near_miss_codes):
            print(f"  {code}")

    # Write plain txt report: one unique code per line, no occurrence counts
    with open(args.out, "w", encoding="utf-8-sig") as f:
        f.write(f"Seiban codes found: {len(counts)}\n")
        f.write("=" * 40 + "\n")
        for code in sorted(counts):
            flag = "  <- had stray spaces, fixed" if code in space_fixed_codes else ""
            f.write(f"{code}{flag}\n")

        if near_miss_codes:
            f.write("\nNEAR-MISS codes (matched loosely, review manually):\n")
            f.write("=" * 40 + "\n")
            for code in sorted(near_miss_codes):
                f.write(f"{code}\n")

    print(f"\nReport written to: {args.out}")


if __name__ == "__main__":
    main()
