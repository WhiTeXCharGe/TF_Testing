"""
seiban_extractor.py
--------------------------------------------------------------
Scans every cell of an .xlsx / .xlsm worker x date grid (e.g. SU_Others)
and pulls out seiban / tool-code strings like 530N03157A / 830300208A
(pattern: 3 digits + 1 alnum + 5 digits + "A", same as Decoder5.TOOLCODE_RE).

Produces TWO output files:

1) Seiban_list_report.txt
   Unique seiban codes only (no bar text), split into 4 sections:
     - contains "新規"
     - contains "クレーム" or "改造"
     - contains none of the three words
     - contains 新規 AND (クレーム or 改造)  [combined -> also listed in
       the 新規 section and the クレーム/改造 section]
   Rule: if a worker's row has a run of cells where the seiban number
   just increments by 1 day-to-day (same task continuing), only the
   FIRST code of that run is listed. If one of those numbers is later
   reused separately (a genuinely different task elsewhere), it still
   gets listed on its own for that occurrence.

2) Log_report.txt
   - Incremental runs: header code's full cell text, then each later
     distinct code in the run indented underneath (full cell text, no
     sheet/cell reference).
   - Not-seiban list: unique plain cell text for cells that had NO
     seiban code at all (e.g. "（仮）", "TSMC F20 P3").

Handles messy cells:
  - full-width / zero-width chars (NFKC normalize)
  - stray spaces INSIDE the code (e.g. "530N 03157A") -> retried after
    stripping all whitespace.

Usage:
    python seiban_extractor.py "path/to/SU_Others.xlsm"
    python seiban_extractor.py "path/to/SU_Others.xlsm" --sheet "予定表_2025"
    python seiban_extractor.py "path/to/SU_Others.xlsm" --range 2026/06/01-2026/07/01
--------------------------------------------------------------
"""
import argparse
import re
import unicodedata
from collections import defaultdict
from datetime import datetime
from openpyxl import load_workbook

# Same core pattern Decoder5.py uses (TOOLCODE_RE)
SEIBAN_RE = re.compile(r"\d{3}[A-Z0-9]\d{5}A")
_WS_RE = re.compile(r"\s+")
_ZERO_WIDTH = {"\u200b", "\u200c", "\u200d", "\ufeff"}
_CODE_SPLIT_RE = re.compile(r"^(\d{3}[A-Z0-9])(\d{5})(A)$")

SHINKI_WORD = "新規"
CLAIM_WORDS = ("クレーム", "改造")


def clean_text(s) -> str:
    if not isinstance(s, str):
        return ""
    s = unicodedata.normalize("NFKC", s)
    s = s.replace("　", " ")  # full-width space -> normal space
    for z in _ZERO_WIDTH:
        s = s.replace(z, "")
    return s


def find_codes(raw_value):
    """Returns list of (code, space_fixed: bool) found in one cell."""
    if raw_value is None:
        return []
    text = clean_text(str(raw_value))
    if not text.strip():
        return []

    strict = set(m.group(0).upper() for m in SEIBAN_RE.finditer(text))
    if strict:
        return [(c, False) for c in strict]

    stripped = _WS_RE.sub("", text)
    fixed = set(m.group(0).upper() for m in SEIBAN_RE.finditer(stripped))
    return [(c, True) for c in fixed]


def classify_tag(text: str) -> str:
    """'shinki' / 'claim' / 'combined' / 'none' based on keywords in the cell text."""
    t = clean_text(text)
    has_shinki = SHINKI_WORD in t
    has_claim = any(w in t for w in CLAIM_WORDS)
    if has_shinki and has_claim:
        return "combined"
    if has_shinki:
        return "shinki"
    if has_claim:
        return "claim"
    return "none"


def split_code(code: str):
    """'530N03157A' -> ('530N', 3157, 'A')"""
    m = _CODE_SPLIT_RE.match(code)
    if not m:
        return None
    prefix, num_str, suffix = m.groups()
    return prefix, int(num_str), suffix


def parse_range_date(s: str):
    s = s.strip()
    for fmt in ("%Y/%m/%d", "%Y-%m-%d"):
        try:
            return datetime.strptime(s, fmt)
        except ValueError:
            continue
    raise ValueError(f"Could not parse date: {s!r} (use YYYY/MM/DD)")


def find_date_header_row(ws, max_scan_rows=12):
    """Find the row containing real date values; returns (row_idx, {col: datetime})."""
    for r in range(1, max_scan_rows + 1):
        date_cols = {}
        for cell in ws[r]:
            if isinstance(cell.value, datetime):
                date_cols[cell.column] = cell.value
        if date_cols:
            return r, date_cols
    return None, {}


def scan_workbook(path, sheet_name=None, date_start=None, date_end=None):
    """
    Returns (occurrences, no_code_texts)
      occurrences: list of dicts with sheet, row, col, cell, code, space_fixed,
                   tag, raw_text
      no_code_texts: set of unique raw cell text that had no seiban at all
    """
    wb = load_workbook(path, data_only=True, read_only=False)
    sheets = [sheet_name] if sheet_name else wb.sheetnames
    use_range = date_start is not None and date_end is not None

    occurrences = []
    no_code_texts = set()

    for sn in sheets:
        if sn not in wb.sheetnames:
            print(f"  [skip] sheet '{sn}' not found in workbook")
            continue
        ws = wb[sn]

        allowed_cols = None
        if use_range:
            header_row, date_cols = find_date_header_row(ws)
            if header_row is None:
                print(f"  [skip] sheet '{sn}': no date header row found, can't scope by date")
                continue
            allowed_cols = {c for c, dt in date_cols.items() if date_start <= dt <= date_end}
            if not allowed_cols:
                print(f"  [skip] sheet '{sn}': no date columns fall inside the given range")
                continue

        for row in ws.iter_rows():
            for cell in row:
                if allowed_cols is not None and cell.column not in allowed_cols:
                    continue
                if cell.value is None:
                    continue

                codes = find_codes(cell.value)
                if not codes:
                    if isinstance(cell.value, str) and cell.value.strip():
                        no_code_texts.add(cell.value.strip())
                    continue

                tag = classify_tag(str(cell.value))
                for code, space_fixed in codes:
                    occurrences.append({
                        "sheet": sn,
                        "cell": cell.coordinate,
                        "row": cell.row,
                        "col": cell.column,
                        "code": code,
                        "space_fixed": space_fixed,
                        "tag": tag,
                        "raw_text": str(cell.value),
                    })
    return occurrences, no_code_texts


def build_runs(occurrences, max_col_gap=1):
    """
    Group occurrences by (sheet, row), sorted by column, into runs where
    consecutive cells share the same code-prefix/suffix + same tag, and the
    number either repeats or increments by exactly 1, within max_col_gap
    columns of each other. Returns a list of runs (each a list of occurrence
    dicts in column order).
    """
    by_row = defaultdict(list)
    for o in occurrences:
        parts = split_code(o["code"])
        if parts is None:
            continue
        by_row[(o["sheet"], o["row"])].append((o["col"], o, parts))

    runs = []
    for key, entries in by_row.items():
        entries.sort(key=lambda t: t[0])
        run = [entries[0]]
        for i in range(1, len(entries)):
            col, o, (prefix, num, suffix) = entries[i]
            pcol, po, (pprefix, pnum, psuffix) = run[-1]
            continues = (
                prefix == pprefix
                and suffix == psuffix
                and po["tag"] == o["tag"]
                and (num - pnum) in (0, 1)
                and (col - pcol) <= max_col_gap
            )
            if continues:
                run.append(entries[i])
            else:
                runs.append([r[1] for r in run])
                run = [entries[i]]
        runs.append([r[1] for r in run])
    return runs


def suppress_run_tails(runs):
    """
    For runs longer than 1 cell that contain a genuine increment (a later
    cell's code differs from the run's first code), suppress those later
    occurrences from the "list separately" sets. Returns set of id(occ).
    """
    suppressed = set()
    for run in runs:
        if len(run) < 2:
            continue
        header_code = run[0]["code"]
        for occ in run[1:]:
            if occ["code"] != header_code:
                suppressed.add(id(occ))
    return suppressed


def build_increment_log(runs):
    """
    For runs that contain a genuine increment, build a log entry:
    header raw text, then each later DISTINCT code's first raw text
    (consecutive duplicate codes collapsed).
    """
    entries = []
    for run in runs:
        if len(run) < 2:
            continue
        distinct_codes = {o["code"] for o in run}
        if len(distinct_codes) < 2:
            continue  # pure repeat, nothing incremental to log

        header_text = run[0]["raw_text"]
        tails = []
        last_code = run[0]["code"]
        for occ in run[1:]:
            if occ["code"] != last_code:
                tails.append(occ["raw_text"])
                last_code = occ["code"]
        entries.append((header_text, tails))
    return entries


def build_category_sets(occurrences, suppressed_ids):
    shinki, claim, none_cat, combined = set(), set(), set(), set()
    for o in occurrences:
        if id(o) in suppressed_ids:
            continue
        code, tag = o["code"], o["tag"]
        if tag == "combined":
            shinki.add(code)
            claim.add(code)
            combined.add(code)
        elif tag == "shinki":
            shinki.add(code)
        elif tag == "claim":
            claim.add(code)
        else:
            none_cat.add(code)
    return shinki, claim, none_cat, combined


def main():
    ap = argparse.ArgumentParser(description="Extract seiban/tool codes from an xlsx/xlsm worker x date grid.")
    ap.add_argument("xlsx_path", help="Path to the .xlsx or .xlsm file")
    ap.add_argument("--sheet", default=None, help="Only scan this sheet (default: all sheets)")
    ap.add_argument("--range", default=None,
                     help="Only include cells whose DATE COLUMN falls in this range, "
                          "e.g. --range 2026/06/01-2026/07/01. Requires the sheet to have "
                          "a date header row (worker x date grid, like SU_Others).")
    ap.add_argument("--seiban-out", default="Seiban_list_report.txt", help="Seiban list output path")
    ap.add_argument("--log-out", default="Log_report.txt", help="Log output path")
    ap.add_argument("--max-col-gap", type=int, default=1,
                     help="Max column gap allowed between cells in a continuing run (default 1)")
    args = ap.parse_args()

    date_start = date_end = None
    if args.range:
        parts = [p.strip() for p in args.range.replace("〜", "-").split("-") if p.strip()]
        if len(parts) != 2:
            raise SystemExit(f"--range must be like 2026/06/01-2026/07/01, got: {args.range!r}")
        date_start, date_end = parse_range_date(parts[0]), parse_range_date(parts[1])
        if date_end < date_start:
            date_start, date_end = date_end, date_start

    print(f"Scanning: {args.xlsx_path}" + (f" (sheet: {args.sheet})" if args.sheet else " (all sheets)"))
    if date_start:
        print(f"Date range: {date_start:%Y/%m/%d} - {date_end:%Y/%m/%d}")

    occurrences, no_code_texts = scan_workbook(args.xlsx_path, args.sheet, date_start, date_end)
    runs = build_runs(occurrences, max_col_gap=args.max_col_gap)
    suppressed_ids = suppress_run_tails(runs)
    shinki, claim, none_cat, combined = build_category_sets(occurrences, suppressed_ids)
    increment_log = build_increment_log(runs)

    # ---------- Seiban_list_report.txt ----------
    seiban_lines = []
    seiban_lines.append(f"新規: {len(shinki)}")
    seiban_lines.append("=" * 40)
    seiban_lines.extend(sorted(shinki))

    seiban_lines.append("")
    seiban_lines.append(f"クレーム/改造: {len(claim)}")
    seiban_lines.append("=" * 40)
    seiban_lines.extend(sorted(claim))

    seiban_lines.append("")
    seiban_lines.append(f"該当なし (新規/クレーム/改造を含まない): {len(none_cat)}")
    seiban_lines.append("=" * 40)
    seiban_lines.extend(sorted(none_cat))

    seiban_lines.append("")
    seiban_lines.append(f"新規 + クレーム/改造 (combined): {len(combined)}")
    seiban_lines.append("=" * 40)
    seiban_lines.extend(sorted(combined))

    with open(args.seiban_out, "w", encoding="utf-8-sig") as f:
        f.write("\n".join(seiban_lines) + "\n")

    # ---------- Log_report.txt ----------
    log_lines = []
    log_lines.append(f"Incremental runs: {len(increment_log)}")
    log_lines.append("=" * 40)
    if not increment_log:
        log_lines.append("(none found)")
    for header, tails in increment_log:
        log_lines.append(header)
        for t in tails:
            log_lines.append(f"    {t}")
        log_lines.append("")

    log_lines.append(f"Not seiban (no code found): {len(no_code_texts)}")
    log_lines.append("=" * 40)
    for t in sorted(no_code_texts):
        log_lines.append(t)

    with open(args.log_out, "w", encoding="utf-8-sig") as f:
        f.write("\n".join(log_lines) + "\n")

    print("\n".join(seiban_lines))
    print()
    print("\n".join(log_lines))
    print(f"\nWritten: {args.seiban_out}")
    print(f"Written: {args.log_out}")


if __name__ == "__main__":
    main()
