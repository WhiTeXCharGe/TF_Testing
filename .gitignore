# Maven build output — regenerated by `mvn package` or `docker build`
target/

# Local Docker work folders — these hold YOUR yaml inputs/outputs/status,
# not part of the project itself
work/

# IDE / editor noise
.idea/
.vscode/
*.iml
.classpath
.project
.settings/

# OS noise
.DS_Store
Thumbs.db

# Java crash logs / heap dumps
hs_err_pid*.log
*.hprof

# Logs
*.log

# Score progress dumps
score_progress_*.txt

# Files EmployeeSchedule writes into the working directory when building/solving.
# load_log.txt is written by the build step (observed when running the tests);
# the others are written by solveFromYaml during a real solve.
load_log.txt
initial_score.txt
stage1_score.txt
final_score.txt
score_progress.txt
solver_log.txt
