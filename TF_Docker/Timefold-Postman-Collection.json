{
  "info": {
    "_postman_id": "timefold-local-v2",
    "name": "Timefold Solver — Local Test Suite",
    "description": "Tests against the Express service (port 3001).\n\nSetup:\n1. Build the image once: cd web/Timefold && docker build -t timefold-scheduler:local .\n2. Start Express: cd web/service && npm install && npm run dev\n3. Run request 1 — Express auto-starts the Docker container, no terminal command needed.\n\nTimefold runs standalone fine (mvn exec:java) — Docker is only for the webapp integration flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string",
      "description": "Auto-set by request 1. Do not edit manually."
    },
    {
      "key": "envFilePath",
      "value": "C:/Users/Seiya/Desktop/work/Timefold/web/Timefold/work/input/EnvConfig.yaml",
      "type": "string",
      "description": "CHANGE THIS — absolute path to your EnvConfig.yaml"
    },
    {
      "key": "schedFilePath",
      "value": "C:/Users/Seiya/Desktop/work/Timefold/web/Timefold/work/input/Schedule.yaml",
      "type": "string",
      "description": "CHANGE THIS — absolute path to your Schedule.yaml"
    }
  ],
  "item": [
    {
      "name": "── MAIN FLOW ──────────────────────────────",
      "item": [
        {
          "name": "1  POST /runSolver — upload YAMLs (auto-starts Docker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('Got runId', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.runId).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.status).to.equal('Submitted');",
                  "    pm.collectionVariables.set('runId', json.runId);",
                  "    console.log('runId =', json.runId);",
                  "    console.log('Watch the Express terminal for docker logs.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "env",
                  "type": "file",
                  "src": "{{envFilePath}}",
                  "description": "Your EnvConfig.yaml"
                },
                {
                  "key": "sched",
                  "type": "file",
                  "src": "{{schedFilePath}}",
                  "description": "Your Schedule.yaml"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/runSolver",
              "host": ["{{baseUrl}}"],
              "path": ["runSolver"]
            },
            "description": "Uploads both YAML files. Express saves them and immediately spawns:\n  docker run --rm -e RUN_ID=<runId> -v .../input/<runId>:/work/input:ro ...\n\nThe solver container starts in the background. Poll request 2 to track progress.\nDocker logs stream to the Express terminal window."
          }
        },
        {
          "name": "2  GET /status/{{runId}} — poll progress",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Valid status', () => {",
                  "    const json = pm.response.json();",
                  "    const valid = ['Submitted','Running','Completed','Failed','Cancelled'];",
                  "    pm.expect(json.status).to.be.oneOf(valid);",
                  "",
                  "    const line = `status: ${json.status}  stage: ${json.stage ?? '-'}  progress: ${json.progress ?? 0}`;",
                  "    console.log(line);",
                  "",
                  "    if (json.status === 'Running') {",
                  "        pm.expect(json.stage).to.be.oneOf([1, 2]);",
                  "    }",
                  "    if (json.status === 'Failed') {",
                  "        console.error('FAILED:', JSON.stringify(json.error));",
                  "    }",
                  "    if (json.status === 'Completed') {",
                  "        console.log('Done! Run request 3 to download the result.');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status/{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["status", "{{runId}}"]
            },
            "description": "Keep clicking Send to watch progress. The console log shows:\n  status: Running  stage: 1  progress: 0.4\n\nExpected progression:\n  Submitted → Running (stage 1) → Running (stage 2) → Completed\n\nWhen status is Completed, run request 3.\nIf status is Failed, expand the error field to see what went wrong."
          }
        },
        {
          "name": "3  GET /download/{{runId}} — download result",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('File attachment in response', () => {",
                  "    const cd = pm.response.headers.get('Content-Disposition') ?? '';",
                  "    pm.expect(cd).to.include('attachment');",
                  "    console.log('File ready. Click Send → Save Response → Save to file.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/download/{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["download", "{{runId}}"]
            },
            "description": "Downloads result_Schedule.yaml.\n\nIn Postman: Send → Save Response → Save to file\n\nReturns 409 if the run is not yet Completed. Keep polling request 2 first."
          }
        }
      ]
    },
    {
      "name": "── ERROR INJECTION (test webapp error display) ──",
      "description": "Use PUT /status to inject error states without running Docker.\nRun request 1 first to get a {{runId}}, then use any of these to test how the webapp renders errors.",
      "item": [
        {
          "name": "ERR-A  Failed — InvalidInputData (bad YAML before solve)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Failed\",\n  \"stage\": null,\n  \"progress\": 0,\n  \"error\": {\n    \"type\": \"InvalidInputData\",\n    \"message\": \"worker_list is empty in EnvConfig.yaml\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/status/{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["status", "{{runId}}"]
            },
            "description": "Spec §4 Case A — bad input detected before solver starts. stage=null because the solver never ran."
          }
        },
        {
          "name": "ERR-B  Failed — SolverError (JVM crash mid-solve)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Failed\",\n  \"stage\": 1,\n  \"progress\": 0.3,\n  \"error\": {\n    \"type\": \"SolverError\",\n    \"message\": \"Java heap space exceeded — increase container memory limit\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/status/{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["status", "{{runId}}"]
            },
            "description": "Spec §4 Case B — JVM OOM or uncaught exception at 30% through Stage 1."
          }
        },
        {
          "name": "ERR-C  Failed — OutputError (disk full after solve)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Failed\",\n  \"stage\": 2,\n  \"progress\": 1.0,\n  \"error\": {\n    \"type\": \"OutputError\",\n    \"message\": \"Failed to write result_Schedule.yaml: No space left on device\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/status/{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["status", "{{runId}}"]
            },
            "description": "Spec §4 Case C — solver finished but output write failed. stage=2 progress=1.0 because the solve itself completed."
          }
        },
        {
          "name": "ERR-D  Running Stage 1 — then GET /download → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "console.log('Now run GET /download to see the 409 not-completed response.');"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Running\",\n  \"stage\": 1,\n  \"progress\": 0.5,\n  \"error\": null\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/status/{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["status", "{{runId}}"]
            },
            "description": "Set status back to Running so you can test request 3 returns 409 when called too early."
          }
        }
      ]
    },
    {
      "name": "── API CONTRACT (negative tests) ──",
      "description": "Verify the server rejects bad input correctly. These do not depend on {{runId}}.",
      "item": [
        {
          "name": "NEG-1  POST /runSolver — missing env → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions env', () => pm.expect(pm.response.json().error.toLowerCase()).to.include('env'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "env", "type": "file", "src": "{{envFilePath}}", "disabled": true},
                {"key": "sched", "type": "file", "src": "{{schedFilePath}}"}
              ]
            },
            "url": {"raw": "{{baseUrl}}/runSolver", "host": ["{{baseUrl}}"], "path": ["runSolver"]}
          }
        },
        {
          "name": "NEG-2  POST /runSolver — missing sched → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions sched', () => pm.expect(pm.response.json().error.toLowerCase()).to.include('sched'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "env", "type": "file", "src": "{{envFilePath}}"},
                {"key": "sched", "type": "file", "src": "{{schedFilePath}}", "disabled": true}
              ]
            },
            "url": {"raw": "{{baseUrl}}/runSolver", "host": ["{{baseUrl}}"], "path": ["runSolver"]}
          }
        },
        {
          "name": "NEG-3  GET /status — unknown runId → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/status/nonexistent_run_00000", "host": ["{{baseUrl}}"], "path": ["status", "nonexistent_run_00000"]}
          }
        },
        {
          "name": "NEG-4  GET /status — bad characters in runId → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/status/bad%20id!", "host": ["{{baseUrl}}"], "path": ["status", "bad%20id!"]}
          }
        },
        {
          "name": "NEG-5  GET /download — run not completed yet → 409",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["// Pre-req: run ERR-D first to set status=Running"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Error says not completed', () => pm.expect(pm.response.json().error).to.include('not completed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/download/{{runId}}", "host": ["{{baseUrl}}"], "path": ["download", "{{runId}}"]},
            "description": "Pre-req: run ERR-D first (sets status=Running). Then this should return 409."
          }
        },
        {
          "name": "NEG-6  GET /download — run is Failed → 409",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["// Pre-req: run ERR-A, ERR-B, or ERR-C first to set status=Failed"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Error says failed', () => pm.expect(pm.response.json().error.toLowerCase()).to.include('fail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/download/{{runId}}", "host": ["{{baseUrl}}"], "path": ["download", "{{runId}}"]},
            "description": "Pre-req: run ERR-A, ERR-B, or ERR-C first. Then this should return 409 with error details."
          }
        }
      ]
    }
  ]
}
