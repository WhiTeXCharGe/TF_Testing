environment:
  workflow_list:
  - id: workflow
    name: Equipment Setup
    phase_list:
    - id: p1
      name: Module Setup
      operation_list:
      - id: p1o1
        name: Heavy
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
      - id: p1o2
        name: Mech
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
      - id: p1o3
        name: Elec
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
    - id: p2
      name: Hardware Setup
      operation_list:
      - id: p2o1
        name: Mech
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
      - id: p2o2
        name: Elec
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
    - id: p3
      name: Function Setup
      operation_list:
      - id: p3o1
        name: QC
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
    - id: p4
      name: Acceptance Inspection
      operation_list:
      - id: p4o1
        name: QC
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
      - id: p4o2
        name: Mech
        work_hours: [8, 10, 12]
        min_worker_num: 2
        max_worker_num: 3
  fab_list:
  - id: f1
    name: AAA Fab1
    region: r1
    customer_company: c1
    unavailable_dates: []
  - id: f2
    name: BBB Fab2
    region: r1
    customer_company: c2
    unavailable_dates: []
  - id: f3
    name: AAA Fab3
    region: r2
    customer_company: c1
    unavailable_dates: []
  - id: f4
    name: BBB Fab4
    region: r2
    customer_company: c2
    unavailable_dates: []
  - id: f5
    name: AAA Fab5
    region: r3
    customer_company: c1
    unavailable_dates: []
  - id: f6
    name: BBB Fab6
    region: r3
    customer_company: c2
    unavailable_dates: []
  region_list:
  - id: r1
    name: America
    max_stay_on: 80
    max_annual_stay: 240
    stay_off_interval: 3
    unavailable_dates:
    - weekly:
        weekdays: [sat, sun]
  - id: r2
    name: Germany
    max_stay_on: 80
    max_annual_stay: 240
    stay_off_interval: 3
    unavailable_dates:
    - weekly:
        weekdays: [sat, sun]
  - id: r3
    name: Taiwan
    max_stay_on: 80
    max_annual_stay: 240
    stay_off_interval: 3
    unavailable_dates:
    - weekly:
        weekdays: [sat, sun]
  customer_company_list:
  - id: c1
    name: AAA
    unavailable_dates: []
  - id: c2
    name: BBB
    unavailable_dates: []
  worker_company_list:
  - id: c3
    name: XXX
    annual_overtime_limit: 360
    monthly_overtime_limit: 40
    unavailable_dates: []
  - id: c4
    name: YYY
    annual_overtime_limit: 360
    monthly_overtime_limit: 40
    unavailable_dates: []
  transite_day_map:
  - from: r1
    to: r2
    days: 3
  - from: r1
    to: r3
    days: 4
  - from: r2
    to: r1
    days: 3
  - from: r2
    to: r3
    days: 4
  - from: r3
    to: r1
    days: 4
  - from: r3
    to: r2
    days: 4
  affinity_tag:
  - id: a1
    weight: 2
  - id: a2
    weight: 1
  - id: a3
    weight: 1
  - id: a4
    weight: -1
  - id: a5
    weight: 1
  - id: a6
    weight: 1
  worker_list:
  - id: w1
    name: AA
    worker_company: c4
    is_manager: true
    role: ''
    skill_map: {p1o2: 3, p1o3: 4, p2o2: 3, p3o1: 3, p4o2: 5}
    worker_type_by_operation:
      p1o2: spot
      p1o3: spot
      p2o2: spot
      p3o1: regular
      p4o2: spot
    fab_suitability_map:
    - kind: region
      suitability: {r1: 1, r2: 1, r3: 1}
    - kind: customer_company
      suitability: {c1: 2, c2: 2}
    unavailable_dates: []
    affinity: []
  - id: w2
    name: AB
    worker_company: c3
    is_manager: false
    role: ''
    skill_map: {p1o1: 4, p2o2: 3, p3o1: 4, p4o1: 4, p4o2: 1}
    worker_type_by_operation:
      p1o1: regular
      p2o2: spot
      p3o1: regular
      p4o1: regular
      p4o2: spot
    fab_suitability_map:
    - kind: region
      suitability: {r1: 1, r2: 2, r3: 1}
    - kind: customer_company
      suitability: {c1: 1, c2: 1}
    unavailable_dates:
    - date: 2025/08/28
    - date: 2025/10/17
