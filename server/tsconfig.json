{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  // Tests must not reach dist/: it is shipped verbatim inside the packaged
  // Electron app (see extraResources in the root package.json), and compiling
  // them would drag their vitest / socket.io-client devDependency imports in
  // with them.
  "exclude": ["src/**/*.test.ts"]
}
