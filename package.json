{
  "name": "gantt-chart-editor",
  "version": "0.1.0",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "jest --passWithNoTests",
    "test:jest": "jest --config jest.config.cjs --workerIdleMemoryLimit=512MB",
    "test:cypress": "cypress open",
    "test:cypress:run": "cypress run",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently \"npm run dev\" \"npm run dev:server\" \"npm run electron:compile -- --watch --preserveWatchOutput\" \"wait-on tcp:5173 tcp:3010 && electron .\"",
    "electron:build": "vite build && npm run build --prefix server && npm run electron:compile && electron-builder"
  },
  "build": {
    "appId": "com.timefold.gantt-chart-editor",
    "productName": "GanttChartEditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**",
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app-dist"
      },
      {
        "from": "server/dist",
        "to": "server/dist"
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "server/package.json",
        "to": "server/package.json"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "gantt-task-react": "^0.3.9",
    "js-yaml": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "cypress": "^13.17.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.5.3",
    "vite": "^5.4.0",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "cypress@13.17.0": true,
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
