{
  "name": "timefold-scheduler-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:service": "npm run dev --prefix ../service",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:service\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "seed": "ts-node --esm scripts/seedDatabase.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
